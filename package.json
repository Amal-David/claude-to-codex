{
  "name": "claude-to-codex",
  "version": "0.2.0",
  "private": true,
  "description": "Bidirectional Claude Code and Codex CLI handoffs with durable local context and an interactive terminal supervisor.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amal-David/claude-to-codex.git"
  },
  "bugs": {
    "url": "https://github.com/Amal-David/claude-to-codex/issues"
  },
  "homepage": "https://github.com/Amal-David/claude-to-codex#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "handoff": "node plugins/claude-to-codex/skills/handoff/scripts/claude-to-codex.mjs",
    "install:standalone": "node scripts/install-standalone.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:terminal": "python3 -m unittest discover -s test/terminal -p \"test_*.py\""
  },
  "keywords": [
    "claude-to-codex",
    "claude-code",
    "claude-fable",
    "claude-code-plugin",
    "claude-code-skill",
    "claude-plugin",
    "claude-skill",
    "codex",
    "codex-cli",
    "gpt-5.6",
    "openai-codex",
    "handoff",
    "agent-handoff",
    "agent-skills",
    "ai-agents",
    "context-transfer",
    "terminal-automation",
    "developer-tools",
    "llm-tools",
    "plugin"
  ],
  "bin": {
    "claude-to-codex": "./plugins/claude-to-codex/skills/handoff/scripts/claude-to-codex.mjs",
    "agent-handoff": "./plugins/claude-to-codex/skills/handoff/scripts/handoff.mjs"
  }
}
